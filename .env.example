# Backend (all optional in development)
PORT=8080
DATABASE_URL=postgres://intuition:intuition@localhost:5432/intuition?sslmode=disable   # empty = in-memory store
SERVER_SECRET=replace-with-a-long-random-string    # signs player tokens; REQUIRED when APP_ENV=production
APP_ENV=development
CONTENT_DIR=../content
STATIC_DIR=../frontend/dist
DAILY_TIMEZONE=Asia/Kolkata                        # when the daily challenge rolls over (IANA name), default UTC
DAILY_SALT=intuition                               # changes which questions the generated daily sets pick
ALLOWED_ORIGINS=                                   # comma-separated; empty = allow all (dev). Same-host is always allowed.
INCLUDE_DRAFTS=false                               # serve reviewStatus=draft questions (local authoring only)

# Frontend build
VITE_DEMO_FALLBACK=false                           # true = ship the offline answer pack in production builds (weakens anti-cheat)
