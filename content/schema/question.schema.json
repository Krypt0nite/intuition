{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intuition/question-pack",
  "title": "INTUITION question pack",
  "description": "Editor hints only. The authoritative checks live in `go run ./cmd/content validate`.",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "pack": { "type": "string" },
    "description": { "type": "string" },
    "defaults": { "type": "object" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subcategory", "difficulty", "questionType", "answerType", "scenario", "question", "options", "correctIndex", "reveal", "explanation", "intuitionTrap", "principle", "tags", "concepts", "variantGroup"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
        "questionType": { "type": "string" },
        "answerType": { "type": "string" },
        "visualType": { "enum": ["none", "emoji", "diagram", "image"] },
        "emoji": { "type": "string" },
        "scenario": { "type": "string", "minLength": 10 },
        "question": { "type": "string", "pattern": "\\?$" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "shuffle": { "type": "boolean" },
        "reveal": { "type": "string", "maxLength": 100 },
        "explanation": { "type": "string" },
        "intuitionTrap": { "type": "string" },
        "principle": { "type": "string" },
        "funFact": { "type": "string" },
        "caveat": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "goDeeper": { "type": "object", "required": ["text"], "properties": { "equation": { "type": "string" }, "text": { "type": "string" }, "example": { "type": "string" } }, "additionalProperties": false },
        "tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
        "concepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "variantGroup": { "$ref": "#/$defs/slug" },
        "estimatedTime": { "type": "integer", "minimum": 0, "maximum": 120 },
        "chain": { "type": "object", "required": ["id", "step", "total"], "properties": { "id": { "type": "string" }, "step": { "type": "integer" }, "total": { "type": "integer" } } },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "reviewStatus": { "enum": ["draft", "reviewed", "verified"] },
        "reviewNotes": { "type": "string" }
      }
    }
  }
}
